NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=0

DATABASE_URL=postgresql://reimbursement:reimbursement@localhost:5432/medical_reimbursement
PGSSL=false
PGPOOL_MAX=10

